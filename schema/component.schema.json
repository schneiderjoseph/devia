{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComponentSpec",
  "type": "object",
  "required": [
    "id",
    "name",
    "states"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "a11y": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
