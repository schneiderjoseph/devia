{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checklist",
  "type": "object",
  "required": [
    "id",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
