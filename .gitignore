# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Node / Python local junk if scripts added later
node_modules/
__pycache__/
.venv/
dist/
build/
.env
.env.*
!.env.example

# Généré par `devia read` — un instantané de la mémoire, pas la mémoire
.devia/reader.html
.devia/.update-check.json

# Généré par `devia contribute submit` — reconstruit depuis le record et le fixture,
# qui eux sont des preuves et restent versionnés
.devia/contributions/*/payload/

# Local secrets / audits
*.pem
*.key
secrets/
audit-output/
